@startuml

package scratch{
    package model{
        abstract class Action{
            +value : DoubleProperty
            +valueProperty() : DoubleProperty
            +execute(Cursor) : void
            +actionType() : ActionType
            +setValue(double) : void
            +getValue() : double
            +actionDetail(ActionType) : ActionType
            +actionDetailValue(ActionType) : String
            +setSelectedValue(String, BooleanProperty, int, ObservableList<Action>) : void
        }
        class ActionFactory{
            +createAction(ActionType) : Action
        }
        class ActionCatalog{
            -palettActions : ObservableList<ActionType>

            +getPalettActions() : ObservableList<ActionType>
            +getAction(int) : ActionType
        }
        enum ActionType{
            MOVE_FORWARD
            TURN_LEFT
            TURN_RIGHT
            PEN_UP
            PEN_DOWN

            -label : String

            +ActionType(String)
            +getLabel() : String
            +toString() : String
        }
        class Cursor{
            -world : CursorWorld
            -point : Position
            -penDown : boolean
            -startPosition : Point
            -angle : DoubleProperty

            +Cursor(CursorWorld, Point)
            +getPosition() : Point
            +getAngle() : double
            +angleProperty() : DoubleProperty
            +moveForward(double) : void
            +rotate(double) : void
            +isPenDown() : boolean
            +setPen(boolean) : void
            +reset() : void
            +getWorld() : CursorWorld
        }
        class CursorWorld{
            -segments : List<Segment>
            +getSegments() : List<Segment>
            +addSegment(Segment) : void
            +clearSegments() : void
        }
        class MoveForward{
            +MoveForward(double)
            +execute(Cursor)
            +actionType() : ActionType
            +getValue() : double
            +setValue(double) : void
            +toString() : String
        }
        class Pen{
            -write : boolean

            +Pen(boolean)
            +execute() : void
            +actionType() : ActionType
            +setValue(double) : void
            +getValue() : double
            +toString() : String
        }
        class Point{
            -x : DoubleProperty
            -y : DoubleProperty

            +Point(double, double)
            +setX() : void
            +setY() : void
            +getX() : double
            +getY() : double
        }
        class Program{
            -action : ObservableList<Action>

            +getActions() : ObservableList<Action>
            +addAction(int) : void
            +deleteAction(int) : void
            +removeAll() : void
            +up(int) : void
            +down(int) : void
            +duplicateAction) : void
            +executeNext(int, Cursor) : void
            +save(File) : void
            +load(File) : void
            +isPenStateValid() : boolean
        }
        class Segment{
            -start : Point
            -end : Point

            +getStart() : Point
            +setStart(Point) : void
            +getEnd() : Point
            +setEnd(Point) : void
        }
        class Turn{
            +Turn(double)
            +execute() : void
            +actionType() : ActionType
            +getValue() : double
            +setValue(double) : void
            +toString() : String
        }
    }
    package viewmodel{
        class MainViewModel{
            -cursor : Cursor
            -program : Program
            -world : CursorWorld
            -actionIndex : IntegerProperty
            -executionIndex : IntegerProperty
            -programLoaded : BooleanProperty
            -running : BooleanProperty
            ...

            +MainViewModel(Cursor)
            +getPalettAction() : ObservableList<ActionType>
            +getProgramActions() : ObservableList<Action>
            +addAction() : void
            +deleteAction() : void
            +canDown() : BooleanBinding
            +canExecute() : BooleanProperty
            +actionDetailsBinding() : StringBindings
            +configureBindingsAndListeners() : void
            +cursorXProperty() : DoubleProperty
            +cursorYProperty() : DoubleProperty
            +newFile() : void
            +saveFile() : void

            ...()

        }
    }
    package view{
        class MainView{
            -TURTLE_HEAD_SIZE = 2
            -TURTLE_SIZE = 20
            -vm : MainViewModel
            -turtle : Polygon
            -palletListView : ListView<ActionType>
            -actionListView : ListView<Action>
            -programBox : VBox
            ...

            +MainView(MainViewModel)
            +beautify() : void
            +configureMenuBox() : void
            +configLeft() : void
            +configCenter() : void
            +configRight() : void
            +loadData() : void
            +configActions() : void
            +configSelectionModels() : void
            +configButtonsDisabling() : void
            +configureBindingsAndListeners() : void
            +drawTurtle() : void
            +redrawTurtle() : void
            +drawSegments() : void
            +openFile() : void

            ...()
        }
    }

    class App{
        +start(Stage) : void
        +main(String[]) : void
    }

    App ..> CursorWorld : <create>
    App ..> Cursor : <create>
    App ..> MainViewModel : <create>
    App ..> MainView : <create>

    MoveForward --|> Action
    Pen --|> Action
    Turn --|> Action

    MainView *-->  MainViewModel

    MainViewModel *-->  Cursor
    MainViewModel *-->  CursorWorld
    MainViewModel *-->  Program

    Action  --> ActionType : <use>
    ActionFactory ..> Action : <create>
    ActionCatalog ..> ActionType : <depend>

    Cursor *--> CursorWorld
    Cursor *--> Point

    CursorWorld ..> Segment

    Program o-- Action

    Segment *--> Point
}

@enduml

abstract class AbstractList
abstract AbstractCollection
interface List
interface Collection

List <|-- AbstractList
Collection <|-- AbstractCollection

Collection <|- List
AbstractCollection <|- AbstractList
AbstractList <|-- ArrayList

class ArrayList {
Object[] elementData
size()
}

enum TimeUnit {
DAYS
HOURS
MINUTES